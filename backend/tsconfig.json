{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "guess-the-draw/**/*.ts",
    "puissance4/**/*.ts",
    "hangman/**/*.ts",
    "tic-tac-toe/**/*.ts"
  ]
}
